LOAD DATABASE

FROM mysql://root:123123@localhost:3306/employees

INTO postgresql://dorian:1251*@localhost:5432/pdb_employees

WITH
    include drop,
    create tables,
    create indexes,
    reset sequences,
    workers = 8,
    concurrency = 2,
    batch rows = 10000

SET
    maintenance_work_mem to '256MB',
    work_mem to '32MB'

CAST
    type datetime to timestamp,
    type enum to text
;
